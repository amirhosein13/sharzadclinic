// ───────────────────────────────────────────────────────────────
//  کلینیک زیبایی شهرزاد — اسکیمای دیتابیس
//  هر مدلی که قرار است داده‌ی اپلیکیشن قدیمی (SQL Server) را
//  بپذیرد یک فیلد `legacyId` دارد تا import ایمن و تکرارپذیر باشد.
// ───────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── کاربران پنل مدیریت ────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  RECEPTION
  OPERATOR // پرسنل درمانگر — فقط نوبت‌ها و درآمد خودش را می‌بیند
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  /// موبایل کاربر پنل — برای بازیابی رمز عبور با کد پیامکی
  phone        String?
  role         Role      @default(RECEPTION)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// اگر این حساب متعلق به یکی از پرسنل درمانگر باشد
  staffId String? @unique
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  auditLogs AuditLog[]

  ticketMessages TicketMessage[]

  cashCloses CashClose[]
  campaigns  Campaign[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  /// شمارش تلاش‌های ناموفق ورود روی همین ایندکس انجام می‌شود
  @@index([action, detail, createdAt])
  @@map("audit_logs")
}

// ─── مشتریان / مراجعین ─────────────────────────────────────────

enum Gender {
  FEMALE
  MALE
  OTHER
}

model Customer {
  id           String    @id @default(cuid())
  legacyId     String?   @unique // کلید رکورد در دیتابیس قدیمی
  firstName    String
  lastName     String
  phone        String    @unique
  email        String?
  nationalCode String?
  gender       Gender    @default(FEMALE)
  birthDate    DateTime?
  address      String?
  notes        String? // یادداشت پزشکی/پذیرش
  allergies    String?
  /// «از کجا با ما آشنا شدید؟» — کلید از REFERRAL_SOURCES
  referralSource String?
  /// کد اختصاصی این مشتری برای معرفی دوستان. با اولین نیاز ساخته می‌شود.
  referralCode   String? @unique
  /// «پیامک تبلیغاتی برایم نفرست». پیامک‌های ضروری (کد ورود، یادآوری نوبت)
  /// را تحت تأثیر قرار نمی‌دهد.
  smsOptOut      Boolean @default(false)
  /// اجازه‌ی انتشار عکس‌های قبل/بعد در سایت.
  /// null = نپرسیده‌ایم، true = اجازه داده، false = نداده یا پس گرفته.
  /// وضعیت فعلی این است؛ سند حقوقی‌اش در رضایت‌نامه‌ی امضاشده می‌ماند.
  photoPublishAllowed Boolean?
  /// توضیح آزاد، مثلاً نام معرف
  referralNote   String?
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appointments Appointment[]
  treatments   TreatmentRecord[]
  payments     Payment[]
  testimonials Testimonial[]
  packages     Package[]
  followUps    FollowUp[]
  consents     ConsentSignature[]
  feedbacks    Feedback[]
  tickets      SupportTicket[]
  discountUses DiscountUse[]
  waitlist     WaitlistEntry[]

  referralsMade     Referral[] @relation("Referrer")
  referralReceived  Referral?  @relation("Referred")
  campaignMessages  CampaignRecipient[]

  @@index([lastName, firstName])
  @@index([createdAt])
  @@index([referralSource])
  @@map("customers")
}

// ─── خدمات ─────────────────────────────────────────────────────

model ServiceCategory {
  id          String   @id @default(cuid())
  legacyId    String?  @unique
  slug        String   @unique
  title       String
  description String?
  icon        String? // نام آیکون lucide
  image       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id               String   @id @default(cuid())
  legacyId         String?  @unique
  slug             String   @unique
  title            String
  shortDescription String?
  description      String? // متن کامل (Markdown-ish)
  image            String?
  gallery          String[] @default([])
  priceFrom        Int? // تومان
  priceTo          Int?
  durationMinutes  Int      @default(60)
  bufferMinutes    Int      @default(10) // فاصله‌ی اجباری تا نوبت بعدی
  /// گام نمایش ساعت‌های شروع. خالی یعنی از تنظیمات عمومی استفاده شود.
  slotStepMinutes  Int?
  /// مبلغ ثابت رزرو (بیعانه) به تومان. اگر تعیین شود، رزرو آنلاین فقط
  /// پس از پرداخت این مبلغ قطعی می‌شود.
  depositAmount    Int?
  /// پس از این تعداد روز از جلسه، پیگیری «حالتان چطور است؟» ساخته شود. صفر یعنی خاموش
  followUpDays     Int      @default(0)
  sessionsNeeded   String? // مثلا «۴ تا ۶ جلسه»
  preparation      String? // آمادگی قبل از انجام
  aftercare        String? // مراقبت‌های بعد از انجام
  isFeatured       Boolean  @default(false)
  isBookable       Boolean  @default(true)
  isActive         Boolean  @default(true)
  order            Int      @default(0)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  faqs         ServiceFaq[]
  appointments Appointment[]
  staff        StaffOnService[]
  treatments   TreatmentRecord[]
  packages     Package[]
  waitlist     WaitlistEntry[]
  feedbacks    Feedback[]
  materials    ServiceMaterial[]
  consents     ConsentTemplateService[]

  @@index([categoryId, isActive])
  @@index([isFeatured])
  @@map("services")
}

model ServiceFaq {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  order     Int     @default(0)

  @@map("service_faqs")
}

// ─── پرسنل ─────────────────────────────────────────────────────

model Staff {
  id              String  @id @default(cuid())
  legacyId        String? @unique
  slug            String  @unique
  name            String
  title           String // مثلا «متخصص پوست و مو»
  bio             String?
  avatar          String?
  licenseNo       String?
  instagram       String?
  order           Int     @default(0)
  isActive        Boolean @default(true)
  acceptsBookings Boolean @default(true)

  /// حقوق پایه‌ی ماهانه به تومان
  baseSalary        Int @default(0)
  /// درصد پورسانت پیش‌فرض از مبلغ خدمات انجام‌شده
  commissionPercent Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       StaffOnService[]
  schedules      StaffSchedule[]
  timeOffs       TimeOff[]
  appointments   Appointment[]
  treatments     TreatmentRecord[]
  payrollPeriods PayrollPeriod[]
  feedbacks      Feedback[]
  expenses       Expense[]
  user           User?

  @@map("staff")
}

model StaffOnService {
  staffId           String
  serviceId         String
  staff             Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service           Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// اگر خالی باشد، درصد پیش‌فرض خود پرسنل اعمال می‌شود
  commissionPercent Int?

  @@id([staffId, serviceId])
  @@map("staff_services")
}

/// برنامه‌ی هفتگی هر پرسنل. weekday: 0=شنبه ... 6=جمعه
model StaffSchedule {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String // "09:00"
  endTime   String // "18:00"
  isActive  Boolean @default(true)

  @@unique([staffId, weekday, startTime])
  @@map("staff_schedules")
}

model TimeOff {
  id      String   @id @default(cuid())
  staffId String?
  staff   Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  from    DateTime
  to      DateTime
  reason  String?

  @@index([from, to])
  @@map("time_offs")
}

/// ساعات کاری خودِ کلینیک (نمایش عمومی + محدودکردن رزرو)
model WorkingHour {
  id        String  @id @default(cuid())
  weekday   Int     @unique
  isOpen    Boolean @default(true)
  startTime String  @default("09:00")
  endTime   String  @default("21:00")

  @@map("working_hours")
}

// ─── نوبت‌دهی ──────────────────────────────────────────────────

enum AppointmentStatus {
  PENDING // ثبت‌شده، منتظر تأیید
  CONFIRMED // تأییدشده
  DONE // انجام‌شده
  CANCELLED // لغوشده
  NO_SHOW // مراجعه نکرد
}

model Appointment {
  id             String            @id @default(cuid())
  legacyId       String?           @unique
  code           String            @unique // کد پیگیری برای مشتری
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staffId        String?
  staff          Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(PENDING)
  note           String? // یادداشت مشتری
  adminNote      String?
  source         String            @default("website")
  /// زمان ارسال پیامک یادآوری — برای جلوگیری از ارسال تکراری
  reminderSentAt DateTime?
  /// تا این لحظه نوبت برای پرداخت رزرو شده و کس دیگری نمی‌تواند آن را بگیرد.
  /// پس از پرداخت موفق خالی می‌شود؛ اگر منقضی شود نوبت آزاد می‌گردد.
  holdExpiresAt  DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  payments  Payment[]
  followUps FollowUp[]
  feedbacks Feedback[]

  @@index([startsAt])
  @@index([status, startsAt])
  @@index([staffId, startsAt])
  @@map("appointments")
}

// ─── پرونده و پرداخت (مقصد داده‌های اپ قدیمی) ──────────────────

model TreatmentRecord {
  id          String   @id @default(cuid())
  legacyId    String?  @unique
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId     String?
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  performedAt DateTime
  sessionNo   Int?
  description String?
  beforePhoto String?
  afterPhoto  String?

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([customerId, performedAt])
  @@map("treatment_records")
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING // در انتظار پرداخت در درگاه
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(cuid())
  legacyId      String?       @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  amount        Int // تومان
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PAID)
  /// برای پرداخت آنلاین: نام درگاه، کد Authority و شماره پیگیری تراکنش
  gateway       String?
  authority     String?       @unique
  refId         String?
  /// تا وقتی پرداخت آنلاین تأیید نشده خالی است
  paidAt        DateTime?
  reference     String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paidAt])
  @@index([status])
  @@map("payments")
}

// ─── گالری قبل/بعد ─────────────────────────────────────────────

model GalleryItem {
  id          String   @id @default(cuid())
  /// اگر از یک پرونده‌ی درمانی ساخته شده، تا دو بار اضافه نشود
  treatmentId String?  @unique
  title       String
  description String?
  beforeImage String
  afterImage  String?
  serviceSlug String? // برای فیلترکردن
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
  @@map("gallery_items")
}

// ─── مجله / بلاگ ───────────────────────────────────────────────

model PostCategory {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  posts Post[]

  @@map("post_categories")
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  coverImage      String?
  readingMinutes  Int       @default(5)
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  views           Int       @default(0)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@map("posts")
}

// ─── نظرات مشتریان ─────────────────────────────────────────────

model Testimonial {
  id          String    @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName  String
  serviceName String?
  rating      Int       @default(5)
  body        String
  avatar      String?
  isApproved  Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([isApproved])
  @@map("testimonials")
}

// ─── پیام‌های تماس ─────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  subject   String?
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

// ─── تنظیمات عمومی سایت ────────────────────────────────────────

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── حقوق و دستمزد ─────────────────────────────────────────────

/// یک دوره‌ی حقوقی (معمولاً یک ماه شمسی) برای هر پرسنل
model PayrollPeriod {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  /// ابتدا و انتهای دوره
  from DateTime
  to   DateTime

  /// برچسب فارسی دوره، مثلاً «شهریور ۱۴۰۵»
  label String

  baseSalary       Int @default(0)
  /// مجموع مبلغ خدماتی که مبنای پورسانت است
  commissionBase   Int @default(0)
  commissionAmount Int @default(0)
  bonus            Int @default(0)
  deduction        Int @default(0)
  total            Int @default(0)

  /// تعداد نوبت‌های انجام‌شده در دوره
  sessionCount Int @default(0)

  note      String?
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([staffId, from, to])
  @@index([from, to])
  @@map("payroll_periods")
}

// ─── ورود مشتری با کد یکبارمصرف ────────────────────────────────

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("login")
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

// ─── لاگ پیامک و ایمیل ─────────────────────────────────────────

enum NotificationChannel {
  SMS
  EMAIL
}

model NotificationLog {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  recipient  String
  template   String
  body       String
  /// sent | failed | skipped
  status     String
  error      String?
  providerId String?
  createdAt  DateTime            @default(now())

  @@index([createdAt])
  @@index([channel, status])
  @@map("notification_logs")
}

// ─── پکیج جلسات ────────────────────────────────────────────────

/// دوره‌ی چندجلسه‌ای که مشتری یکجا می‌خرد (مثلاً «۶ جلسه لیزر کامل بدن»)
model Package {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  title         String
  totalSessions Int
  /// مبلغ کل دوره به تومان
  price         Int    @default(0)
  /// مبلغی که تا الان دریافت شده
  paidAmount    Int    @default(0)

  purchasedAt DateTime  @default(now())
  /// پس از این تاریخ جلسات باقی‌مانده منقضی می‌شوند
  expiresAt   DateTime?
  note        String?
  isActive    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]
  treatments   TreatmentRecord[]

  @@index([customerId, isActive])
  @@map("packages")
}

// ─── پیگیری مراجعین ────────────────────────────────────────────

/// نظرسنجی پس از هر مراجعه — پایه‌ی گزارش رضایت و پیگیری نارضایتی
model Feedback {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// هر نوبت فقط یک نظرسنجی دارد
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffId       String?
  staff         Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)

  /// آدرس یکبارمصرفِ داخل پیامک، تا مشتری بدون ورود نظر بدهد
  token String @unique

  /// رضایت کلی، ۱ تا ۵
  rating         Int?
  /// از چه چیزهایی راضی بوده / نبوده — کلیدهای FEEDBACK_ASPECTS
  goodTags       String[]
  badTags        String[]
  comment        String?
  /// آیا کلینیک را به دیگران پیشنهاد می‌کند؟
  wouldRecommend Boolean?
  /// اجازه‌ی انتشار متن نظر در سایت
  canPublish     Boolean  @default(false)

  status          FeedbackStatus @default(NEW)
  /// یادداشت مدیر هنگام رسیدگی — داخلی، مشتری نمی‌بیند
  managerNote     String?
  /// پاسخی که به خود مشتری نشان داده می‌شود
  replyToCustomer String?
  handledAt       DateTime?

  sentAt      DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, submittedAt])
  @@index([rating])
  @@index([customerId])
  @@map("feedbacks")
}

enum FeedbackStatus {
  /// هنوز پر نشده
  NEW
  /// پر شده و مدیر هنوز ندیده
  SUBMITTED
  /// مدیر دیده
  SEEN
  /// نارضایتی رسیدگی شد
  RESOLVED
}

/// دسته‌ی هزینه — اجاره، حقوق، مواد مصرفی، قبوض و...
model ExpenseCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  /// هزینه‌های این دسته از خرید مواد می‌آید و دستی ثبت نمی‌شود
  isSystem Boolean @default(false)
  order    Int     @default(0)

  createdAt DateTime @default(now())

  expenses Expense[]

  @@map("expense_categories")
}

/// یک قلم هزینه‌ی کلینیک
model Expense {
  id         String          @id @default(cuid())
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// اگر هزینه به یک پرسنل مربوط است (حقوق، پاداش)
  staffId    String?
  staff      Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)

  title   String
  /// مبلغ به تومان
  amount  Int
  /// تاریخی که پول خرج شده
  spentAt DateTime
  note    String?

  /// پول این هزینه از صندوق (کشوی نقد) برداشته شده؛ در بستن صندوق کم می‌شود
  paidFromCash Boolean @default(false)

  /// هزینه‌ی خودکارِ ناشی از مصرف انبار — دستی قابل ویرایش نیست
  stockMovementId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spentAt])
  @@index([categoryId, spentAt])
  @@map("expenses")
}

/// قلم انبار — ژل، سرسوزن، ویال بوتاکس و...
model InventoryItem {
  id       String  @id @default(cuid())
  name     String
  /// واحد شمارش: عدد، سی‌سی، میلی‌لیتر، بسته
  unit     String  @default("عدد")
  /// موجودی فعلی (می‌تواند اعشاری باشد، مثل ۲.۵ سی‌سی)
  stock    Float   @default(0)
  /// زیر این مقدار هشدار کمبود داده می‌شود
  minStock Float   @default(0)
  /// آخرین بهای خرید هر واحد به تومان — مبنای محاسبه‌ی سود
  unitCost Int     @default(0)
  supplier String?
  note     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  services  ServiceMaterial[]

  @@index([isActive])
  @@map("inventory_items")
}

/// هر ورود، خروج یا اصلاح موجودی
model StockMovement {
  id     String            @id @default(cuid())
  itemId String
  item   InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind   StockMovementKind

  /// همیشه مثبت؛ جهتش را kind تعیین می‌کند
  quantity Float
  /// بهای هر واحد در همین حرکت (برای خرید)
  unitCost Int   @default(0)

  /// اگر مصرف بابت یک جلسه‌ی درمان بوده
  treatmentId String?
  note        String?

  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

enum StockMovementKind {
  /// خرید و ورود به انبار
  IN
  /// مصرف
  OUT
  /// اصلاح موجودی پس از شمارش
  ADJUST
  /// ضایعات و خرابی
  WASTE
}

/// مواد مصرفیِ استانداردِ هر خدمت — مبنای کسر خودکار و بهای تمام‌شده
model ServiceMaterial {
  id        String        @id @default(cuid())
  serviceId String
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// مقدار مصرف در هر جلسه
  quantity Float

  @@unique([serviceId, itemId])
  @@map("service_materials")
}

/// تیکت پشتیبانی — گفت‌وگوی دوطرفه‌ی مشتری با کلینیک
model SupportTicket {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  subject  String
  category String       @default("other")
  status   TicketStatus @default(OPEN)

  /// آخرین پیام مال کیست — مبنای «منتظر پاسخ ما» یا «منتظر پاسخ مشتری»
  lastSender       TicketSender @default(CUSTOMER)
  /// پیام خوانده‌نشده‌ی مشتری برای کارکنان
  unreadByStaff    Boolean      @default(true)
  /// پاسخ خوانده‌نشده‌ی کارکنان برای مشتری
  unreadByCustomer Boolean      @default(false)

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages TicketMessage[]

  @@index([status, updatedAt])
  @@index([customerId])
  @@map("support_tickets")
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  sender TicketSender
  /// اگر پاسخ از سمت کلینیک است، چه کسی نوشته
  userId String?
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

enum TicketStatus {
  /// منتظر پاسخ کلینیک
  OPEN
  /// کلینیک پاسخ داده، منتظر مشتری
  ANSWERED
  /// بسته شده
  CLOSED
}

enum TicketSender {
  CUSTOMER
  STAFF
}

enum FollowUpKind {
  NO_SHOW // مراجعه نکرد
  NEXT_SESSION // وقت جلسه‌ی بعدی دوره رسیده
  POST_CARE // پیگیری بعد از درمان
  CUSTOM // یادداشت دستی منشی
}

enum FollowUpStatus {
  OPEN
  DONE
  SNOOZED
  DISMISSED
}

/// کارتابل پیگیری منشی — چه کسی باید تماس بگیرد و چرا
model FollowUp {
  id            String       @id @default(cuid())
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  kind   FollowUpKind
  dueAt  DateTime
  reason String?

  status    FollowUpStatus @default(OPEN)
  /// نتیجه‌ی تماس: پاسخ نداد، نوبت گرفت، منصرف شد و...
  outcome   String?
  note      String?
  handledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
  @@index([customerId])
  @@map("follow_ups")
}

// ─── رضایت‌نامه دیجیتال ────────────────────────────────────────

model ConsentTemplate {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  body     String
  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatures ConsentSignature[]
  services   ConsentTemplateService[]

  @@map("consent_templates")
}

/// کدام رضایت‌نامه به کدام خدمت مربوط است.
/// اگر یک قالب هیچ خدمتی نداشته باشد، عمومی است و برای همه پیشنهاد می‌شود.
model ConsentTemplateService {
  templateId String
  serviceId  String
  template   ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([templateId, serviceId])
  @@index([serviceId])
  @@map("consent_template_services")
}

model ConsentSignature {
  id         String          @id @default(cuid())
  templateId String
  template   ConsentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// نام و کد ملی همان‌طور که هنگام امضا وارد شده
  fullName      String
  nationalCode  String?
  /// تصویر امضا به شکل data URL
  signatureData String?
  /// متن رضایت‌نامه در لحظه‌ی امضا، تا تغییر بعدی قالب سند را عوض نکند
  bodySnapshot  String
  /// در همین امضا، اجازه‌ی انتشار عکس هم داده شد؟ سند این موافقت است.
  allowPhotoPublish Boolean @default(false)

  signedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([customerId, signedAt])
  @@map("consent_signatures")
}

// ─── کد تخفیف ──────────────────────────────────────────────────

enum DiscountKind {
  PERCENT
  FIXED
}

model DiscountCode {
  id          String       @id @default(cuid())
  code        String       @unique
  kind        DiscountKind @default(PERCENT)
  /// درصد (۱ تا ۱۰۰) یا مبلغ ثابت به تومان
  value       Int
  /// حداقل مبلغ خرید برای اعمال تخفیف
  minAmount   Int?
  /// سقف مبلغ تخفیف برای کدهای درصدی
  maxDiscount Int?

  maxUses   Int?
  usedCount Int  @default(0)

  startsAt  DateTime?
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uses DiscountUse[]

  @@index([isActive, expiresAt])
  @@map("discount_codes")
}

model DiscountUse {
  id            String       @id @default(cuid())
  codeId        String
  code          DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String?
  /// مبلغ تخفیف اعمال‌شده به تومان
  amount        Int
  usedAt        DateTime     @default(now())

  @@index([codeId])
  @@map("discount_uses")
}

// ─── لیست انتظار ───────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  CANCELLED
}

model WaitlistEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  /// بازه‌ی زمانی مورد نظر مشتری
  fromDate DateTime
  toDate   DateTime
  note     String?

  status     WaitlistStatus @default(WAITING)
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, fromDate])
  @@map("waitlist_entries")
}

// ─── بستن صندوق آخر شب ─────────────────────────────────────────

/// شمارش واقعی کشوی نقد در پایان هر روز، کنار آنچه سیستم انتظار دارد.
/// اختلاف همان‌جا دیده می‌شود، نه آخر ماه.
model CashClose {
  id String @id @default(cuid())

  /// روزِ صندوق، ساعت ۰۰:۰۰ به وقت تهران
  day DateTime @unique

  /// عکس لحظه‌ی بستن — بعداً اگر پرداختی با تاریخ گذشته ثبت شود، این عدد
  /// عوض نمی‌شود تا معلوم بماند آن شب چه چیزی شمرده شده
  expectedCash   Int
  expectedCard   Int
  expectedOnline Int
  expectedOther  Int
  /// هزینه‌هایی که همان روز از صندوق پرداخت شده‌اند
  cashExpenses   Int @default(0)

  /// آنچه واقعاً در کشو شمرده شد
  countedCash Int
  /// شمرده منهای انتظار — منفی یعنی کسری
  difference  Int

  note String?

  closedById String?
  closedBy   User?   @relation(fields: [closedById], references: [id], onDelete: SetNull)
  closedAt   DateTime @default(now())

  @@index([day])
  @@map("cash_closes")
}

// ─── کد معرف ───────────────────────────────────────────────────

enum ReferralStatus {
  /// معرفی ثبت شده، ولی معرفی‌شده هنوز جلسه‌ای انجام نداده
  PENDING
  /// اولین جلسه انجام شد و هدیه‌ها صادر شدند
  REWARDED
  /// باطل شد (مثلاً معرفی‌شده هیچ‌وقت نیامد یا تقلبی بود)
  VOID
}

/// «چه کسی چه کسی را آورد».
/// هدیه فقط وقتی صادر می‌شود که معرفی‌شده واقعاً یک جلسه انجام داده باشد،
/// وگرنه با ثبت‌نام‌های الکی قابل سوءاستفاده است.
model Referral {
  id String @id @default(cuid())

  referrerId String
  referrer   Customer @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  /// هر مشتری فقط یک بار می‌تواند «معرفی‌شده» باشد
  referredId String   @unique
  referred   Customer @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  status ReferralStatus @default(PENDING)

  /// کدهای هدیه‌ای که هنگام واجدشرایط‌شدن صادر شدند
  referrerRewardCode String?
  referredRewardCode String?
  rewardAmount       Int?

  createdAt  DateTime  @default(now())
  rewardedAt DateTime?

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

// ─── پیامک گروهی ───────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  SENDING
  DONE
  CANCELLED
}

/// یک ارسال گروهی. گیرنده‌ها هنگام شروع «قفل» می‌شوند تا اگر ارسال نیمه‌کاره
/// ماند، ادامه‌اش کسی را دوباره پیامک نکند.
model Campaign {
  id      String @id @default(cuid())
  title   String
  message String

  /// فیلترِ انتخاب گروه، همان‌طور که کاربر انتخاب کرده
  serviceId       String?
  inactiveMonths  Int?
  onlyWithVisits  Boolean @default(false)

  status CampaignStatus @default(DRAFT)

  total   Int @default(0)
  sent    Int @default(0)
  failed  Int @default(0)
  skipped Int @default(0)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  recipients CampaignRecipient[]

  @@index([status])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// queued | sent | failed
  status String  @default("queued")
  error  String?
  sentAt DateTime?

  /// یک نفر در یک کمپین فقط یک بار
  @@unique([campaignId, customerId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ─── آمار سایت ─────────────────────────────────────────────────

/// یک رویداد ساده‌ی سایت. هیچ چیزِ شناسایی‌کننده‌ای ذخیره نمی‌شود —
/// نه IP، نه کوکی، نه شناسه‌ی کاربر. فقط «چه اتفاقی افتاد و کجا».
model SiteEvent {
  id String @id @default(cuid())

  /// service_view | booking_start | booking_service | booking_time | booking_submit | booking_done
  kind String
  /// اگر به یک خدمت مربوط است
  serviceSlug String?

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([serviceSlug, createdAt])
  @@map("site_events")
}
