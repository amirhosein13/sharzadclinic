# ─── دیتابیس ────────────────────────────────────────────────
# با `npm run db:up` یک PostgreSQL لوکال روی داکر بالا می‌آید
DATABASE_URL="postgresql://sharzad:sharzad@localhost:5439/sharzad?schema=public"

# ─── امنیت ──────────────────────────────────────────────────
# حتماً در پروداکشن عوضش کن:  openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_dev_only_secret_at_least_32_characters_long!!"

# ─── آدرس عمومی سایت (برای sitemap و لینک‌های SEO) ──────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── حساب ادمین اولیه (فقط هنگام seed استفاده می‌شود) ───────
ADMIN_EMAIL="admin@sharzadclinic.ir"
ADMIN_PASSWORD="Admin@12345"
ADMIN_NAME="مدیر کلینیک"

# ─── مهاجرت از اپلیکیشن قدیمی (SQL Server) ─────────────────
LEGACY_MSSQL_SERVER="localhost"
LEGACY_MSSQL_PORT="1433"
LEGACY_MSSQL_DATABASE="ClinicOld"
LEGACY_MSSQL_USER="sa"
LEGACY_MSSQL_PASSWORD=""
LEGACY_MSSQL_ENCRYPT="false"
LEGACY_MSSQL_TRUST_CERT="true"

# ─── پیامک ──────────────────────────────────────────────────
# console      = فقط در ترمینال چاپ می‌شود (برای توسعه و تست)
# melipayamak  = ملی پیامک
# kavenegar    = کاوه‌نگار
SMS_PROVIDER="console"

# — ملی پیامک — نام کاربری و رمز خودِ پنل (نه توکن)
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
# شماره‌ی فرستنده‌ی خطتان، مثل 50004000...
MELIPAYAMAK_SENDER=""
# شناسه‌ی «خدمات پایه» (bodyId) که برای کد ورود تأیید شده — یک عدد است
MELIPAYAMAK_OTP_BODY_ID=""

# — کاوه‌نگار
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
# نام الگوی تأییدشده در پنل کاوه‌نگار برای کد ورود
KAVENEGAR_OTP_TEMPLATE=""

# ─── ایمیل (SMTP) ───────────────────────────────────────────
# اگر خالی بماند ایمیل‌ها فقط در ترمینال چاپ می‌شوند
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="کلینیک شهرزاد <no-reply@sharzadclinic.ir>"

# ─── درگاه پرداخت زرین‌پال ──────────────────────────────────
# شناسه‌ی پذیرنده از پنل زرین‌پال (یک UUID سی‌وشش کاراکتری)
ZARINPAL_MERCHANT_ID=""
# true برای تست بدون پول واقعی
ZARINPAL_SANDBOX="true"

# ─── منطقه‌ی زمانی ──────────────────────────────────────────
# اگر خالی بماند، خودکار روی Asia/Tehran تنظیم می‌شود
TZ="Asia/Tehran"

# محل ذخیره‌ی عکس‌های پرونده‌ی مشتری (خارج از public). اگر خالی باشد
# پوشه‌ی storage/private کنار پروژه استفاده می‌شود. روی هاست‌هایی که
# فایل‌سیستم موقتی دارند، این را روی یک دیسک ماندگار تنظیم کنید.
PRIVATE_UPLOAD_DIR=

# ─── پشتیبان‌گیری ───────────────────────────────────────────
# محل نگهداری فایل‌های پشتیبان. روی هاست، یک دیسک ماندگار بدهید.
BACKUP_DIR=
# چند نسخه‌ی آخر نگه داشته شود (پیش‌فرض ۱۴)
BACKUP_KEEP="14"
